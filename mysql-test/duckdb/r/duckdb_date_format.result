SET SESSION time_zone='+00:00';
CREATE DATABASE test_duckdb_df;
USE test_duckdb_df;
CREATE TABLE t_duck (id INT PRIMARY KEY, ts DATETIME(6), dcol DATE,
tcol TIMESTAMP NULL) ENGINE=DuckDB;
CREATE TABLE t_inno (id INT PRIMARY KEY, ts DATETIME(6), dcol DATE,
tcol TIMESTAMP NULL) ENGINE=InnoDB;
